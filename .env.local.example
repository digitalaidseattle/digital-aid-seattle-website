# Note: All environment variables must start with NEXT_PUBLIC_ to be exposed to the client.
NEXT_PUBLIC_VERCEL_GIT_REPO_OWNER=
NEXT_PUBLIC_VERCEL_GIT_PROVIDER=
NEXT_PUBLIC_VERCEL_GIT_REPO_SLUG=

# Required, find them on https://manage.sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# see https://www.sanity.io/docs/api-versioning for how versioning works
NEXT_PUBLIC_SANITY_API_VERSION="2022-11-28"

# Required for the newsletter sign-up (Brevo).
NEXT_PUBLIC_BREVO_API_KEY=

# Optional, Google Analytics. Campaign IDs are comma-separated.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GA_CAMPAIGN_IDS=

# Required to load roles, projects, partners and volunteers from Superhuman (formerly Coda).
NEXT_PUBLIC_CODA_API_TOKEN=